---
import Layout from "@/layouts/Layout.astro";
import DashboardView from "@/components/dashboard/DashboardView";
import { createClient } from "@/lib/supabase";
import { listCategories } from "@/lib/services/categories";
import { getMonthlyComparison } from "@/lib/services/expenses";
import { getOrCreateUserSettings } from "@/lib/services/settings";
import { t } from "@/i18n";
import type { MonthlyComparison } from "@/types";

const EMPTY_COMPARISON: MonthlyComparison = {
  currentTotal: "0.00",
  previousTotal: "0.00",
  totalChangeAmount: "0.00",
  totalChangePercent: null,
  categories: [],
  comparisonAvailable: false,
};

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const comparison = supabase && user ? await getMonthlyComparison(supabase, user.id) : EMPTY_COMPARISON;
const categories = supabase && user ? await listCategories(supabase, user.id) : [];
const settings = supabase && user ? await getOrCreateUserSettings(supabase, user.id) : { currency: "USD" as const };
---

<Layout title={t("meta.dashboardTitle")}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          {t("nav.dashboard")}
        </h1>
        <DashboardView comparison={comparison} currency={settings.currency} categories={categories} client:load />
      </div>
    </div>
  </div>
</Layout>
