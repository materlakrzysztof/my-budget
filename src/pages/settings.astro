---
import Layout from "@/layouts/Layout.astro";
import { SettingsForm } from "@/components/settings/SettingsForm";
import CategoriesManager from "@/components/categories/CategoriesManager";
import { createClient } from "@/lib/supabase";
import { getOrCreateUserSettings } from "@/lib/services/settings";
import { listCategories } from "@/lib/services/categories";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const settings = supabase && user ? await getOrCreateUserSettings(supabase, user.id) : { currency: "USD" as const };
const categories = supabase && user ? await listCategories(supabase, user.id) : [];
---

<Layout title="Settings">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Settings
        </h1>

        <section>
          <h2 class="mb-4 text-lg font-semibold text-white">Currency</h2>
          <SettingsForm initialSettings={settings} client:load />
        </section>

        <section class="mt-10 border-t border-white/10 pt-8">
          <CategoriesManager initialCategories={categories} client:load />
        </section>
      </div>
    </div>
  </div>
</Layout>
