---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import { missingConfigs } from "@/lib/config-status";
import { t } from "@/i18n";

interface Props {
  title?: string;
}

const { title = t("meta.defaultTitle") } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-cosmic">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>{t("banner.warningPrefix")}</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? t("banner.docsLabel")}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <Topbar />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
