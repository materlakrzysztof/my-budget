---
import GlobalAddExpense from "@/components/expenses/GlobalAddExpense";
import { t } from "@/i18n";

const { user } = Astro.locals;
const pathname = Astro.url.pathname;

function linkClass(active: boolean) {
  return [
    "transition-colors hover:text-purple-100 hover:underline",
    active ? "text-purple-100 underline underline-offset-4" : "text-purple-300",
  ];
}
---

<nav
  class="sticky top-0 z-40 flex w-full flex-col gap-2 border-b border-white/10 bg-[#0f1529] px-4 py-2 text-sm text-white/80 backdrop-blur-md sm:flex-row sm:items-center sm:justify-between sm:px-8"
>
  {
    user ? (
      <>
        <span class="hidden text-blue-100/70 sm:inline">{user.email}</span>
        <div class="flex flex-wrap gap-3">
          <a href="/dashboard" class:list={linkClass(pathname === "/dashboard")}>
            {t("nav.dashboard")}
          </a>
          <a href="/expenses" class:list={linkClass(pathname === "/expenses")}>
            {t("nav.expenses")}
          </a>
          <GlobalAddExpense client:load />
          <a href="/settings" class:list={linkClass(pathname === "/settings")}>
            {t("nav.settings")}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              {t("nav.signOut")}
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">{t("nav.notSignedIn")}</span>
        <div class="flex flex-wrap gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t("nav.signIn")}
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t("nav.signUp")}
          </a>
        </div>
      </>
    )
  }
</nav>
