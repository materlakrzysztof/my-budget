{
  "name": "@10x/code-reviewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AI-powered code reviewer built on the Vercel AI SDK with the OpenRouter provider.",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "dev": "node --env-file-if-exists=.env --watch src/cli.ts",
    "review:pr": "node src/review-pr.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.55",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
